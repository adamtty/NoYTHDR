{
  "name": "noythdr",
  "version": "1.0.1",
  "private": true,
  "description": "Firefox extension that prevents YouTube from selecting HDR streams.",
  "scripts": {
    "lint": "web-ext lint --warnings-as-errors",
    "build": "web-ext build --overwrite-dest",
    "sign": "web-ext sign --channel=unlisted",
    "test": "node --test 'tests/*.test.mjs'"
  },
  "devDependencies": {
    "web-ext": "10.8.0"
  }
}
